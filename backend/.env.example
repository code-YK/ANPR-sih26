DATABASE_URL=postgresql+asyncpg://localhost:5432/sentinel
SYNC_DATABASE_URL=postgresql+psycopg2://localhost:5432/sentinel

SANDBOX_CATALOGUE_URL=https://provided-outside-git.invalid/api/ingest
SANDBOX_BROWSER_BASE_URL=https://provided-outside-git.invalid
# Only needed for a sandbox that gates its catalogue/HLS behind a login
# (POST this password to {SANDBOX_BROWSER_BASE_URL}/auth/login for a
# session cookie -- see sandbox_login() in app/pipeline/catalogue.py).
# Leave blank for a no-auth sandbox.
SANDBOX_ACCESS_PASSWORD=
# Only needed for a sandbox that serves RTSP/WHEP unauthenticated off a
# direct IP/host, separate from the CDN/browser host above. Leave blank
# if the sandbox has no such direct-media host.
SANDBOX_STREAM_HOST=
# SANDBOX_RTSP_PORT=8554
# SANDBOX_WEBRTC_PORT=8889

SURVEY_DIR=survey

# Demo authentication. Supply real values locally; never commit a populated
# .env file or use these placeholders as deployed credentials.
SUPER_ADMIN_EMAIL=admin@example.invalid
SUPER_ADMIN_PASSWORD=replace-with-a-long-demo-secret
SUPER_ADMIN_NAME=Sentinel Super Admin
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=12

# Absolute path to an administrator-provided WORM/object-lock retention mount.
# It must be outside this repository. Leave blank for ordinary local development.
AUDIT_ARCHIVE_DIR=

# Shared only between this backend and its local analytics subprocesses.
WORKER_API_TOKEN=replace-with-a-separate-long-worker-secret

# Bounded live-analytics capacity. The default is the verified three-camera
# demo profile; lower this on a smaller machine or raise it only after
# measuring GPU, decoder, and gateway headroom.
MAX_CONCURRENT_VEHICLE_WORKERS=3
MAX_CONCURRENT_PERSON_WORKERS=3
MAX_CONCURRENT_SUSPICIOUS_WORKERS=3

# WebRTC/WHEP preview's own local mediamtx (backend/app/pipeline/webrtc_relay.py)
# defaults to RTSP 8554 / API 9997 -- the same ports scripts/live_test_relay.py's
# separate mediamtx hardcodes (it isn't configurable). Only one can bind a given
# port at a time; uncomment these to move the WebRTC relay's ports out of the way
# when running the Section 5 live-test fixture and the WebRTC preview together.
# MEDIAMTX_RTSP_PORT=8555
# MEDIAMTX_API_PORT=9998
